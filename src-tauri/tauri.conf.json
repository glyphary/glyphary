{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Glyphary",
  "version": "1.0.0-beta.7",
  "identifier": "com.local.glyphary",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Glyphary",
        "width": 1470,
        "height": 956,
        "minWidth": 760,
        "minHeight": 560,
        "decorations": true,
        "theme": "Dark",
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": { "x": 20, "y": 28 },
        "acceptFirstMouse": true,
        "visible": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg"],
    "publisher": "Glyphary contributors",
    "copyright": "Copyright © 2026 Glyphary contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "Markdown Document",
        "description": "Markdown note",
        "mimeType": "text/markdown",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["canvas"],
        "name": "Canvas Document",
        "description": "Obsidian canvas",
        "mimeType": "application/json",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["base"],
        "name": "Base Document",
        "description": "Obsidian base",
        "mimeType": "text/plain",
        "role": "Editor",
        "rank": "Alternate"
      }
    ],
    "macOS": {
        "hardenedRuntime": true,
        "entitlements": "entitlements.plist"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
